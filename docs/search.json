---
layout: null
permalink: /search.json
---
{%- assign docs = site.pages | where_exp: "p", "p.title" | where_exp: "p", "p.search_exclude != true" -%}
[
{%- for p in docs -%}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "content": {{ p.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]